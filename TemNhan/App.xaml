<Application x:Class="TemNhan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TemNhan">
    <Application.Resources>
        <local:EnumNameConverter x:Key="EnumName" />
        <local:NumConverter x:Key="Num" />
        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumName}}" />
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Bảng màu theo P-touch Editor 6: xanh Brother, nền sáng, vùng làm việc xám -->
        <SolidColorBrush x:Key="Accent" Color="#1A56C4" />
        <SolidColorBrush x:Key="AccentSoft" Color="#E8EFFB" />
        <SolidColorBrush x:Key="PanelBg" Color="#FBFCFE" />
        <SolidColorBrush x:Key="WorkBg" Color="#ECECEC" />
        <SolidColorBrush x:Key="RulerBg" Color="#DCE4F2" />
        <SolidColorBrush x:Key="Line" Color="#E1E4EA" />
        <SolidColorBrush x:Key="Muted" Color="#5F6368" />
        <SolidColorBrush x:Key="Ink" Color="#1F2329" />

        <!-- Biểu tượng (khung 24×24, nét) -->
        <Geometry x:Key="IcoNew">M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19</Geometry>
        <Geometry x:Key="IcoOpen">M3,6 H9 L11,8 H21 V19 H3 Z</Geometry>
        <Geometry x:Key="IcoSave">M4,3 H17 L21,7 V21 H4 Z M8,3 V8 H15 V3 M8,21 V14 H17 V21</Geometry>
        <Geometry x:Key="IcoPrint">M7,8 V3 H17 V8 M6,17 H3 V8 H21 V17 H18 M7,13 H17 V21 H7 Z</Geometry>
        <Geometry x:Key="IcoText">M4,4 H20 V20 H4 Z M8,8 H16 M12,8 V17</Geometry>
        <Geometry x:Key="IcoFrame">M3,6 H21 V18 H3 Z M6,9 H18 V15 H6 Z</Geometry>
        <Geometry x:Key="IcoLine">M3,12 H21 M3,8 V16 M21,8 V16</Geometry>
        <Geometry x:Key="IcoBarcode">M4,5 V19 M6.5,5 V19 M8,5 V19 M11,5 V19 M13.5,5 V19 M15,5 V19 M17.5,5 V19 M20,5 V19</Geometry>
        <Geometry x:Key="IcoQr">M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H16.5 V16.5 H14 Z M18,18 H20 V20 H18 Z M14,20 V18.5 M20,14 V16</Geometry>
        <Geometry x:Key="IcoDatabase">M5,6 A7,2.5 0 1 0 19,6 A7,2.5 0 1 0 5,6 M5,6 V18 A7,2.5 0 0 0 19,18 V6 M5,12 A7,2.5 0 0 0 19,12</Geometry>
        <Geometry x:Key="IcoImage">M3,5 H21 V19 H3 Z M3,16 L9,10 L14,15 L17,12 L21,16 M14,8.5 A1.5,1.5 0 1 0 17,8.5 A1.5,1.5 0 1 0 14,8.5</Geometry>
        <Geometry x:Key="IcoClock">M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 M12,7 V12 L15.5,14</Geometry>
        <Geometry x:Key="IcoNumber">M4,9 H20 M4,15 H20 M10,4 L8,20 M16,4 L14,20</Geometry>
        <Geometry x:Key="IcoUndo">M8,5 L3,10 L8,15 M3,10 H15 A5,5 0 0 1 15,20 H11</Geometry>
        <Geometry x:Key="IcoRedo">M16,5 L21,10 L16,15 M21,10 H9 A5,5 0 0 0 9,20 H13</Geometry>

        <!-- Nút lệnh lớn: biểu tượng trên, chữ dưới (biểu tượng lấy từ Tag) -->
        <Style TargetType="Button" x:Key="BigTool">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,4" MinWidth="62">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{TemplateBinding Tag}" Stroke="{StaticResource Accent}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="24" Height="24" Stretch="None" HorizontalAlignment="Center" />
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,0" TextElement.FontSize="12.5" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D3E0F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mọi ô thả xuống: danh sách đúng bề rộng ô chọn (máy đặt menu căn phải thì danh sách rộng hơn sẽ bị lệch trái) -->
        <Style TargetType="ComboBox">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút thường: nền trắng, viền mảnh (như "Check Media" của P-touch) -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="#C9CED6" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút phẳng nhỏ (ẩn bảng, thu phóng) -->
        <Style TargetType="Button" x:Key="Flat">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mục thu gọn được ở bảng trái (▾ Tiêu đề) -->
        <Style TargetType="Expander" x:Key="Section">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,12,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Arrow" Text="▾" Foreground="{StaticResource Muted}" Width="16" FontSize="11" VerticalAlignment="Center" />
                                                <ContentPresenter />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Arrow" Property="Text" Value="▸" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Margin="16,0,0,12" />
                            <Border Height="1" Background="{StaticResource Line}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="Tool">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="Button" x:Key="Primary">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Heading">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Application.Resources>
</Application>
