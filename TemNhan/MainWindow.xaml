<Window x:Class="TemNhan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TemNhan"
        xmlns:m="clr-namespace:TemNhan.Model"
        xmlns:c="clr-namespace:TemNhan.Controls"
        Title="Tem in(THIEUXK)" Icon="app.ico" Width="1360" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontSize="13" AllowDrop="True"
        Drop="Window_Drop" KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Window.Resources>
        <!-- Ô chọn "Chèn trường dữ liệu" dùng chung cho chữ và mã vạch -->
        <ControlTemplate x:Key="FieldPicker" TargetType="ContentControl">
            <Grid Margin="0,4,0,0"
                  Visibility="{Binding DataContext.HasData, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <ComboBox x:Name="Picker" SelectionChanged="InsertField_Changed"
                          ItemsSource="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="＋ Chèn trường dữ liệu…" Margin="7,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" IsHitTestVisible="False" />
            </Grid>
        </ControlTemplate>

        <!-- Ô chọn "Chèn trường đặc biệt": ngày, giờ, số tự tăng (không cần Excel) -->
        <ControlTemplate x:Key="SpecialPicker" TargetType="ContentControl">
            <Grid Margin="0,4,0,0">
                <ComboBox SelectionChanged="InsertSpecial_Changed" DisplayMemberPath="Label"
                          ItemsSource="{Binding DataContext.SpecialFields, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="＋ Ngày in / giờ in / số tự tăng…" Margin="7,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" IsHitTestVisible="False" />
            </Grid>
        </ControlTemplate>

        <!-- Tab kiểu P-touch: chữ, gạch chân xanh khi chọn -->
        <Style x:Key="PropTab" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="10,8,10,6" Margin="0,0,4,0" Cursor="Hand">
                            <ContentPresenter x:Name="Hd" ContentSource="Header" TextElement.Foreground="{StaticResource Muted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Hd" Property="TextElement.Foreground" Value="{StaticResource Accent}" />
                                <Setter TargetName="Hd" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type m:ImageElement}">
            <StackPanel>
                <CheckBox Content="Giữ tỉ lệ ảnh" IsChecked="{Binding KeepAspect}" Margin="0,8,0,0" />
                <CheckBox Content="Chuyển trắng đen (xám)" IsChecked="{Binding Monochrome}" />
                <Button Content="Thay ảnh khác…" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ReplaceImage_Click" />
                <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Ảnh được nhúng trong file mẫu .tnl nên chép file sang máy khác vẫn còn ảnh. Máy in nhiệt / băng chỉ in một màu: ảnh màu sẽ được in theo sắc độ xám." />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:TextElement}">
            <StackPanel>
                <TextBlock Text="Nội dung" Style="{StaticResource Caption}" />
                <TextBox Tag="content" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="56" VerticalContentAlignment="Top" />
                <ContentControl Template="{StaticResource FieldPicker}" />
                <ContentControl Template="{StaticResource SpecialPicker}" />
                <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Gõ {{Tên cột}} để lấy dữ liệu từ Excel khi in hàng loạt." />

                <TextBlock Text="Phông chữ" Style="{StaticResource Caption}" />
                <ComboBox IsEditable="True" IsTextSearchEnabled="True"
                          ItemsSource="{Binding DataContext.FontNames, RelativeSource={RelativeSource AncestorType=Window}}"
                          Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Cỡ chữ (pt)" Foreground="{StaticResource Muted}" />
                        <TextBox Text="{Binding FontSizePt, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                        <ToggleButton IsChecked="{Binding Bold}" Content="B" FontWeight="Bold" Width="30" Height="26" ToolTip="Đậm" />
                        <ToggleButton IsChecked="{Binding Italic}" Content="I" FontStyle="Italic" Width="30" Height="26" Margin="4,0,0,0" ToolTip="Nghiêng" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Căn ngang" Foreground="{StaticResource Muted}" />
                        <ComboBox ItemsSource="{x:Static local:EnumLists.HAligns}" SelectedItem="{Binding HAlign}" ItemTemplate="{StaticResource EnumItem}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Căn dọc" Foreground="{StaticResource Muted}" />
                        <ComboBox ItemsSource="{x:Static local:EnumLists.VAligns}" SelectedItem="{Binding VAlign}" ItemTemplate="{StaticResource EnumItem}" />
                    </StackPanel>
                </Grid>
                <CheckBox Content="Tự thu nhỏ cho vừa khung" IsChecked="{Binding ShrinkToFit}" Margin="0,10,0,0" />
                <CheckBox Content="Tự xuống dòng" IsChecked="{Binding Wrap}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:FrameElement}">
            <StackPanel>
                <TextBlock Text="Độ dày viền (mm)" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding StrokeMm, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="Bo góc (mm)" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding CornerMm, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}" />
                <CheckBox Content="Tô đen" IsChecked="{Binding Filled}" Margin="0,10,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:LineElement}">
            <StackPanel>
                <TextBlock Text="Độ dày (mm)" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding StrokeMm, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="Hướng" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{x:Static local:EnumLists.Orientations}" SelectedItem="{Binding Orientation}" ItemTemplate="{StaticResource EnumItem}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:BarcodeElement}">
            <StackPanel>
                <TextBlock Text="Loại mã" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{x:Static local:EnumLists.BarcodeKinds}" SelectedItem="{Binding Kind}" ItemTemplate="{StaticResource EnumItem}" />
                <TextBlock Text="Dữ liệu" Style="{StaticResource Caption}" />
                <TextBox Tag="content" Text="{Binding Data, UpdateSourceTrigger=PropertyChanged}" />
                <ContentControl Template="{StaticResource FieldPicker}" />
                <ContentControl Template="{StaticResource SpecialPicker}" />
                <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="EAN-13: 12–13 chữ số. Code 39: chữ IN HOA, số, - . $ / + %. QR nhận mọi ký tự, kể cả tiếng Việt." />
                <StackPanel Visibility="{Binding Is1D, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="Hiện chữ dưới mã vạch" IsChecked="{Binding ShowText}" Margin="0,10,0,0" />
                    <TextBlock Text="Cỡ chữ (pt)" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding TextSizePt, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Background="White">
        <!-- Menu chữ (như File · Edit · View · Insert · Format · Layout · Database · Help) -->
        <Menu DockPanel.Dock="Top" Background="White" Padding="4,2">
            <MenuItem Header="_Tệp">
                <MenuItem Header="Mới" InputGestureText="Ctrl+N" Click="New_Click" />
                <MenuItem Header="Mở…" InputGestureText="Ctrl+O" Click="Open_Click" />
                <MenuItem Header="Mở gần đây" SubmenuOpened="RecentMenu_Opened">
                    <MenuItem Header="(chưa có)" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Lưu" InputGestureText="Ctrl+S" Click="Save_Click" />
                <MenuItem Header="Lưu thành…" Click="SaveAs_Click" />
                <MenuItem Header="Xuất">
                    <MenuItem Header="Ảnh PNG (nhãn đang xem)…" Click="ExportPng_Click" />
                    <MenuItem Header="PDF…" Click="ExportPdf_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="In…" InputGestureText="Ctrl+P" Click="Print_Click" />
                <Separator />
                <MenuItem Header="Thoát" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Sửa">
                <MenuItem Header="Hoàn tác" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                <MenuItem Header="Làm lại" InputGestureText="Ctrl+Y" Click="Redo_Click" />
                <Separator />
                <MenuItem Header="Cắt" InputGestureText="Ctrl+X" Click="Cut_Click" />
                <MenuItem Header="Sao chép" InputGestureText="Ctrl+C" Click="Copy_Click" />
                <MenuItem Header="Dán" InputGestureText="Ctrl+V" Click="Paste_Click" />
                <MenuItem Header="Nhân bản" InputGestureText="Ctrl+D" Click="Duplicate_Click" />
                <MenuItem Header="Xoá" InputGestureText="Del" Click="Delete_Click" />
                <MenuItem Header="Chọn tất cả" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
                <Separator />
                <MenuItem Header="Đổi tên trang…" Click="RenameSheet_Click" />
                <MenuItem Header="Nhân bản trang" Click="DuplicateSheet_Click" />
                <MenuItem Header="Xoá trang" Click="DeleteSheet_Click" IsEnabled="{Binding HasManySheets}" />
            </MenuItem>
            <MenuItem Header="_Xem">
                <MenuItem Header="Phóng to" InputGestureText="Ctrl+lăn chuột" Click="ZoomIn_Click" />
                <MenuItem Header="Thu nhỏ" Click="ZoomOut_Click" />
                <MenuItem Header="100%" Click="Zoom100_Click" />
                <MenuItem Header="Vừa màn hình" Click="Fit_Click" />
                <Separator />
                <MenuItem Header="Bắt lưới 0,5 mm" IsCheckable="True" IsChecked="{Binding Snap}" />
                <MenuItem Header="Bảng bên trái" IsCheckable="True" IsChecked="{Binding LeftVisible}" />
                <MenuItem Header="Bảng thuộc tính" IsCheckable="True" IsChecked="{Binding RightVisible}" />
            </MenuItem>
            <MenuItem Header="_Chèn">
                <MenuItem Header="Chữ" Click="AddText_Click" />
                <MenuItem Header="Khung" Click="AddFrame_Click" />
                <MenuItem Header="Đường kẻ" Click="AddLine_Click" />
                <MenuItem Header="Ảnh / logo…" Click="AddImage_Click" />
                <MenuItem Header="Mã vạch" Click="AddBarcode_Click" />
                <MenuItem Header="Mã QR" Click="AddQr_Click" />
                <MenuItem Header="Ngày giờ" Click="AddDate_Click" />
                <MenuItem Header="Số tự tăng" Click="AddNumber_Click" />
                <Separator />
                <MenuItem Header="Trang mới" Click="AddSheet_Click" />
            </MenuItem>
            <MenuItem Header="_Bố cục">
                <MenuItem Header="Nhóm" InputGestureText="Ctrl+G" Click="Group_Click" />
                <MenuItem Header="Bỏ nhóm" InputGestureText="Ctrl+Shift+G" Click="Ungroup_Click" />
                <MenuItem Header="Thứ tự">
                    <MenuItem Header="Lên trên cùng" Click="Front_Click" />
                    <MenuItem Header="Lên một lớp" Click="Forward_Click" />
                    <MenuItem Header="Xuống một lớp" Click="Backward_Click" />
                    <MenuItem Header="Xuống dưới cùng" Click="Back_Click" />
                </MenuItem>
                <MenuItem Header="Căn chỉnh">
                    <MenuItem Header="Trái" Click="AlignLeft_Click" />
                    <MenuItem Header="Giữa (ngang)" Click="CenterH_Click" />
                    <MenuItem Header="Phải" Click="AlignRight_Click" />
                    <Separator />
                    <MenuItem Header="Trên" Click="AlignTop_Click" />
                    <MenuItem Header="Giữa (dọc)" Click="CenterV_Click" />
                    <MenuItem Header="Dưới" Click="AlignBottom_Click" />
                    <Separator />
                    <MenuItem Header="Phân bố đều theo chiều ngang" Click="DistributeH_Click" />
                    <MenuItem Header="Phân bố đều theo chiều dọc" Click="DistributeV_Click" />
                    <MenuItem Header="Vừa vùng in" Click="Maximum_Click" />
                </MenuItem>
                <MenuItem Header="Xoay 90° trái" Click="RotateLeft_Click" />
                <MenuItem Header="Xoay 90° phải" Click="RotateRight_Click" />
                <MenuItem Header="Đổi cỡ">
                    <MenuItem Header="To hơn" Click="Larger_Click" />
                    <MenuItem Header="Nhỏ hơn" Click="Smaller_Click" />
                    <MenuItem Header="Tối đa" Click="Maximum_Click" />
                    <MenuItem Header="Tối đa, giữ tỉ lệ" Click="MaximumRatio_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Dữ liệu">
                <MenuItem Header="Mở file dữ liệu (Excel/CSV)…" Click="OpenData_Click" />
                <MenuItem Header="Đổi sheet…" Click="ChangeSheet_Click" IsEnabled="{Binding HasData}" />
                <MenuItem Header="Tải lại" Click="ReloadData_Click" IsEnabled="{Binding HasData}" />
                <MenuItem Header="Đóng dữ liệu" Click="CloseData_Click" IsEnabled="{Binding HasData}" />
            </MenuItem>
            <MenuItem Header="T_rợ giúp">
                <MenuItem Header="Phím tắt" Click="Shortcuts_Click" />
                <MenuItem Header="Giới thiệu" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Thanh lệnh lớn -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,4,8,6">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoNew}" Content="Mới" Click="New_Click" ToolTip="Nhãn mới (Ctrl+N)" />
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoOpen}" Content="Mở" Click="Open_Click" ToolTip="Mở mẫu .tnl hoặc file Brother .lbx (Ctrl+O)" />
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoSave}" Content="Lưu" Click="Save_Click" ToolTip="Ctrl+S" />
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoPrint}" Content="In" Click="Print_Click" ToolTip="In (Ctrl+P)" />
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoUndo}" Content="Hoàn tác" Click="Undo_Click" ToolTip="Ctrl+Z" />
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoRedo}" Content="Làm lại" Click="Redo_Click" ToolTip="Ctrl+Y" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoText}" Content="Chữ" Click="AddText_Click" />
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoFrame}" Content="Khung" Click="AddFrame_Click" />
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoLine}" Content="Đường kẻ" Click="AddLine_Click" />
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoBarcode}" Content="Mã vạch" Click="AddBarcode_Click" />
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoQr}" Content="Mã QR" Click="AddQr_Click" />
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoImage}" Content="Ảnh" Click="AddImage_Click" ToolTip="Chèn ảnh / logo" />
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoClock}" Content="Ngày giờ" Click="AddDate_Click" ToolTip="Ngày / giờ lấy lúc in" />
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoNumber}" Content="Đánh số" Click="AddNumber_Click" ToolTip="Số tự tăng 001, 002… mỗi nhãn in ra" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BigTool}" Tag="{StaticResource IcoDatabase}" Content="Dữ liệu" Click="OpenData_Click" ToolTip="Mở Excel/CSV để in hàng loạt" />
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Sẵn sàng" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="236" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightCol" Width="290" />
            </Grid.ColumnDefinitions>

            <!-- Bảng trái: máy in, khổ nhãn, màu giấy -->
            <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Flat}" Content="◂ Ẩn" Padding="10,5" HorizontalAlignment="Left" Click="HideLeft_Click" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,0,14,8">
                            <Expander Header="Máy in" Style="{StaticResource Section}">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" ToolTip="{Binding SelectedPrinter}" />
                                    <TextBlock Text="Khổ tem của máy in" Foreground="{StaticResource Muted}" Margin="0,8,0,3" />
                                    <Grid>
                                        <ComboBox ItemsSource="{Binding PrinterMedia}" SelectedItem="{Binding SelectedPrinterMedia}"
                                                  ToolTip="Khổ khai báo trong driver / Control Panel (Printing Preferences, Print Server Properties → Forms)"
                                                  MaxDropDownHeight="420" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <!-- Danh sách đúng bằng bề rộng ô chọn (máy đặt menu căn phải thì danh sách rộng hơn sẽ bị lệch trái) -->
                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                </ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Display}" ToolTip="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding PrinterMediaHint}" Margin="7,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding NoPrinterMediaSelected, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <Viewbox Width="70" Height="70" Margin="0,10,0,0">
                                        <Canvas Width="48" Height="48">
                                            <Path Data="M10,6 H38 A3,3 0 0 1 41,9 V42 A3,3 0 0 1 38,45 H10 A3,3 0 0 1 7,42 V9 A3,3 0 0 1 10,6 Z" Fill="#3A3F47" />
                                            <Path Data="M12,10 H36 V16 H12 Z" Fill="#5B616B" />
                                            <Path Data="M15,12 H33 V14 H15 Z" Fill="#F2F2F2" />
                                            <Path Data="M12,22 H36 V38 H12 Z" Fill="#2C3036" />
                                            <Path Data="M20,27 H28 V31 H20 Z" Fill="#8FB4F0" />
                                        </Canvas>
                                    </Viewbox>
                                    <Button Content="Kiểm tra khổ giấy" Margin="0,10,0,0" Padding="0,4" Click="CheckMedia_Click"
                                            ToolTip="Hỏi driver máy in xem có nhận đúng khổ nhãn hiện tại không" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Khổ nhãn" Style="{StaticResource Section}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition Height="6" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Rộng" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                        <TextBox Grid.Column="1" Text="{Binding Doc.WidthMm, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding Doc.AutoLength}" />
                                        <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource Muted}" />
                                        <TextBlock Grid.Row="2" Text="Cao" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Doc.HeightMm, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource Muted}" />
                                    </Grid>
                                    <TextBlock Text="Khổ có sẵn" Foreground="{StaticResource Muted}" Margin="0,10,0,3" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="PresetBox" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                                  DisplayMemberPath="Name" ToolTip="Chọn để áp dụng khổ nhãn" />
                                        <TextBlock Text="Chọn khổ…" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Foreground="{StaticResource Muted}" Visibility="{Binding NoPresetSelected, Converter={StaticResource BoolToVis}}" />
                                        <Button Grid.Column="1" Content="＋" Width="28" Padding="0,2" Margin="4,0,0,0" Click="AddPreset_Click"
                                                ToolTip="Lưu khổ Rộng × Cao hiện tại vào danh sách" />
                                        <Button Grid.Column="2" Content="✕" Width="28" Padding="0,2" Margin="4,0,0,0" Click="DeletePreset_Click"
                                                ToolTip="Xoá khổ đang chọn khỏi danh sách" IsEnabled="{Binding HasPresetSelected}" />
                                    </Grid>
                                    <Button Content="Khôi phục danh sách mặc định" Style="{StaticResource Flat}" Foreground="{StaticResource Accent}"
                                            HorizontalAlignment="Left" Padding="0,4" Margin="0,4,0,0" FontSize="11.5" Click="ResetPresets_Click" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Lề và độ dài" Style="{StaticResource Section}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Lề" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                        <TextBox Grid.Column="1" Text="{Binding Doc.MarginMm, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Vạch lề đỏ chấm trên nhãn; dùng cho căn chỉnh và &quot;Vừa vùng in&quot;" />
                                        <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource Muted}" />
                                    </Grid>
                                    <CheckBox Content="Độ dài tự động" IsChecked="{Binding Doc.AutoLength}" Margin="0,8,0,0"
                                              ToolTip="Chiều rộng nhãn tự bằng mép phải đối tượng xa nhất + lề (như bỏ &quot;Fix Length&quot; của P-touch)" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Hướng" Style="{StaticResource Section}">
                                <StackPanel>
                                    <RadioButton Content="Ngang (Landscape)" IsChecked="{Binding IsLandscape}" Margin="0,2" />
                                    <RadioButton Content="Dọc (Portrait)" IsChecked="{Binding IsPortrait}" Margin="0,2" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="Màu giấy" Style="{StaticResource Section}">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding PaperColors}" SelectedValuePath="Hex" SelectedValue="{Binding Doc.PaperColor}" Width="130" HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="34" Height="16" Background="{Binding Hex}" BorderBrush="#B0B6C0" BorderThickness="1" CornerRadius="2" />
                                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="Chỉ để xem trước. Khi in, nền luôn trắng." Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Lưới" Style="{StaticResource Section}">
                                <CheckBox Content="Bắt lưới 0,5 mm" IsChecked="{Binding Snap}" Margin="0" ToolTip="Giữ Alt khi kéo để tạm tắt" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Vùng giữa: tab, thước, khung thiết kế, bảng dữ liệu -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" MinHeight="150" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="DataRowDef" Height="0" />
                </Grid.RowDefinitions>

                <!-- Tab các trang: ‹ › Trang 1 · Trang 2 · ＋ -->
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                        <Button Style="{StaticResource Flat}" Content="‹" FontSize="15" Width="24" Click="PrevSheet_Click" ToolTip="Trang trước (Ctrl+PageUp)" />
                        <Button Style="{StaticResource Flat}" Content="›" FontSize="15" Width="24" Click="NextSheet_Click" ToolTip="Trang sau (Ctrl+PageDown)" Margin="0,0,6,0" />
                        <ListBox x:Name="SheetTabs" ItemsSource="{Binding Sheets}" SelectedItem="{Binding ActiveSheet}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <EventSetter Event="MouseDoubleClick" Handler="SheetTab_DoubleClick" />
                                    <Setter Property="ToolTip" Value="Bấm đúp để đổi tên · chuột phải để nhân bản / xoá" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="10,0" Height="31" Cursor="Hand">
                                                    <TextBlock x:Name="Txt" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource Ink}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Accent}" />
                                                        <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Đổi tên trang…" Click="RenameSheet_Click" />
                                    <MenuItem Header="Nhân bản trang" Click="DuplicateSheet_Click" />
                                    <Separator />
                                    <MenuItem Header="Xoá trang" Click="DeleteSheet_Click" IsEnabled="{Binding HasManySheets}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <Button Style="{StaticResource Flat}" Content="+" FontSize="17" Foreground="{StaticResource Accent}" Width="30" Click="AddSheet_Click" ToolTip="Thêm trang mới" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource RulerBg}" BorderBrush="#C5CDDA" BorderThickness="0,0,1,1">
                        <TextBlock Text="mm" FontSize="9.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <c:Ruler x:Name="TopRuler" Grid.Column="1" Orientation="Horizontal" />
                    <c:Ruler x:Name="LeftRuler" Grid.Row="1" Orientation="Vertical" />

                    <ScrollViewer x:Name="CanvasScroll" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource WorkBg}" ScrollChanged="CanvasScroll_ScrollChanged">
                        <c:LabelCanvas x:Name="Canvas" HorizontalAlignment="Left" VerticalAlignment="Top">
<c:LabelCanvas.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Cắt" InputGestureText="Ctrl+X" Click="Cut_Click" />
                                    <MenuItem Header="Sao chép" InputGestureText="Ctrl+C" Click="Copy_Click" />
                                    <MenuItem Header="Dán" InputGestureText="Ctrl+V" Click="Paste_Click" />
                                    <MenuItem Header="Nhân bản" InputGestureText="Ctrl+D" Click="Duplicate_Click" />
                                    <MenuItem Header="Xoá" InputGestureText="Del" Click="Delete_Click" />
                                    <Separator />
                                    <MenuItem Header="Nhóm" InputGestureText="Ctrl+G" Click="Group_Click" />
                                    <MenuItem Header="Bỏ nhóm" Click="Ungroup_Click" />
                                    <MenuItem Header="Thứ tự">
                                        <MenuItem Header="Lên trên cùng" Click="Front_Click" />
                                        <MenuItem Header="Lên một lớp" Click="Forward_Click" />
                                        <MenuItem Header="Xuống một lớp" Click="Backward_Click" />
                                        <MenuItem Header="Xuống dưới cùng" Click="Back_Click" />
                                    </MenuItem>
                                    <MenuItem Header="Căn chỉnh">
                                        <MenuItem Header="Trái" Click="AlignLeft_Click" />
                                        <MenuItem Header="Giữa (ngang)" Click="CenterH_Click" />
                                        <MenuItem Header="Phải" Click="AlignRight_Click" />
                                        <MenuItem Header="Trên" Click="AlignTop_Click" />
                                        <MenuItem Header="Giữa (dọc)" Click="CenterV_Click" />
                                        <MenuItem Header="Dưới" Click="AlignBottom_Click" />
                                    </MenuItem>
                                    <MenuItem Header="Xoay 90° trái" Click="RotateLeft_Click" />
                                    <MenuItem Header="Xoay 90° phải" Click="RotateRight_Click" />
                                </ContextMenu>
                            </c:LabelCanvas.ContextMenu>
                        </c:LabelCanvas>
                    </ScrollViewer>

                    <!-- Hiện lại bảng đã ẩn -->
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Flat}" Content="▸ Hiện" Padding="8,4" Margin="6,0,0,22"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="White" Click="ShowLeft_Click"
                            Visibility="{Binding LeftHidden, Converter={StaticResource BoolToVis}}" />
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Flat}" Content="Hiện ◂" Padding="8,4" Margin="0,0,22,64"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="ShowRight_Click"
                            Visibility="{Binding RightHidden, Converter={StaticResource BoolToVis}}" />

                    <!-- Thu phóng: − 100 % + -->
                    <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"
                            Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Flat}" Content="−" FontSize="15" Width="30" Height="28" Click="ZoomOut_Click" ToolTip="Thu nhỏ" />
                            <Button Style="{StaticResource Flat}" Width="62" Click="Fit_Click" ToolTip="Bấm để vừa màn hình">
                                <TextBlock x:Name="ZoomText" Text="100 %" />
                            </Button>
                            <Button Style="{StaticResource Flat}" Content="+" FontSize="15" Width="30" Height="28" Click="ZoomIn_Click" ToolTip="Phóng to" />
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource Line}"
                              Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" />

                <!-- Bảng dữ liệu in hàng loạt -->
                <DockPanel Grid.Row="3" Background="White" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                    <DockPanel DockPanel.Dock="Top" Margin="10,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Đổi sheet" Padding="8,2" Click="ChangeSheet_Click" Margin="0,0,6,0" />
                            <Button Content="Tải lại" Padding="8,2" Click="ReloadData_Click" Margin="0,0,6,0" ToolTip="Đọc lại file sau khi sửa trong Excel" />
                            <Button Content="Đóng dữ liệu" Padding="8,2" Click="CloseData_Click" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Button Style="{StaticResource Flat}" Content="◀" Width="26" Height="24" Click="PrevRecord_Click" ToolTip="Bản ghi trước" />
                            <TextBlock Text="{Binding RecordText}" MinWidth="58" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Button Style="{StaticResource Flat}" Content="▶" Width="26" Height="24" Click="NextRecord_Click" ToolTip="Bản ghi sau" />
                        </StackPanel>                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DataInfo" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Mẹo: kéo tiêu đề cột thả vào chữ / mã vạch trên nhãn để gán dữ liệu; thả vào chỗ trống để tạo chữ mới." FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="DataGrid" ItemsSource="{Binding DataView}" IsReadOnly="True" SelectionMode="Extended"
                              CanUserSortColumns="False" CanUserAddRows="False" HeadersVisibility="All" RowHeaderWidth="44"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                              AutoGeneratingColumn="DataGrid_AutoGeneratingColumn" LoadingRow="DataGrid_LoadingRow"
                              SelectionChanged="DataGrid_SelectionChanged" CanUserReorderColumns="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ColumnHeader_MouseDown" />
                                <EventSetter Event="PreviewMouseMove" Handler="ColumnHeader_MouseMove" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="ToolTip" Value="Kéo thả vào chữ / mã vạch trên nhãn để gán dữ liệu cột này" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                    </DataGrid>
                </DockPanel>
            </Grid>

            <!-- Bảng phải: thuộc tính, chia tab như P-touch (Text / Layout / More) -->
            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Flat}" Content="Ẩn ▸" Padding="10,5" HorizontalAlignment="Right" Click="HideRight_Click" />

                    <Grid>
                        <TabControl x:Name="PropTabs" Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="0"
                                    Margin="10,4,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TabItem Style="{StaticResource PropTab}" Header="{Binding PanelTitle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="6,6,16,12">
                                        <ContentControl x:Name="ElementEditor" Content="{Binding Selected}" Focusable="False"
                                                        Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,0"
                                                   Visibility="{Binding IsMulti, Converter={StaticResource BoolToVis}}">
                                            Đang chọn nhiều đối tượng. Dùng tab <Run FontWeight="SemiBold">Bố cục</Run> để căn chỉnh, xoay, đổi cỡ cùng lúc;
                                            tab <Run FontWeight="SemiBold">Khác</Run> để nhóm lại.<LineBreak /><LineBreak />
                                            Ctrl + bấm để thêm / bỏ một đối tượng khỏi vùng chọn.
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Style="{StaticResource PropTab}" Header="Bố cục">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="6,6,16,12">
                                        <Grid Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="X (mm)" Style="{StaticResource Caption}" />
                                                <TextBox Text="{Binding Selected.X, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Y (mm)" Style="{StaticResource Caption}" />
                                                <TextBox Text="{Binding Selected.Y, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1">
                                                <TextBlock Text="Rộng (mm)" Style="{StaticResource Caption}" />
                                                <TextBox Text="{Binding Selected.W, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2">
                                                <TextBlock Text="Cao (mm)" Style="{StaticResource Caption}" />
                                                <TextBox Text="{Binding Selected.H, Converter={StaticResource Num}, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Xoay" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="↺ 90°" Width="64" Click="RotateLeft_Click" ToolTip="Xoay 90° sang trái" />
                                            <Button Content="↻ 90°" Width="64" Margin="6,0,0,0" Click="RotateRight_Click" ToolTip="Xoay 90° sang phải" />
                                            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource Muted}"
                                                       Text="{Binding Selected.Rotation, StringFormat=Góc: {0}°}" Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <TextBlock Text="Căn chỉnh" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                                        <UniformGrid Columns="3">
                                            <Button Content="⇤ Trái" Margin="0,0,4,4" Click="AlignLeft_Click" />
                                            <Button Content="↔ Giữa" Margin="0,0,4,4" Click="CenterH_Click" />
                                            <Button Content="Phải ⇥" Margin="0,0,0,4" Click="AlignRight_Click" />
                                            <Button Content="⤒ Trên" Margin="0,0,4,4" Click="AlignTop_Click" />
                                            <Button Content="↕ Giữa" Margin="0,0,4,4" Click="CenterV_Click" />
                                            <Button Content="Dưới ⤓" Margin="0,0,0,4" Click="AlignBottom_Click" />
                                        </UniformGrid>
                                        <UniformGrid Columns="2">
                                            <Button Content="Đều ngang" Margin="0,0,4,0" Click="DistributeH_Click" ToolTip="Phân bố đều theo chiều ngang (≥ 3 đối tượng)" />
                                            <Button Content="Đều dọc" Click="DistributeV_Click" ToolTip="Phân bố đều theo chiều dọc (≥ 3 đối tượng)" />
                                        </UniformGrid>
                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="Một đối tượng: căn theo nhãn (trừ lề). Nhiều đối tượng: căn theo nhau." />

                                        <TextBlock Text="Cỡ" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                                        <UniformGrid Columns="2">
                                            <Button Content="To hơn" Margin="0,0,4,4" Click="Larger_Click" />
                                            <Button Content="Nhỏ hơn" Margin="0,0,0,4" Click="Smaller_Click" />
                                            <Button Content="Vừa vùng in" Margin="0,0,4,0" Click="Maximum_Click" />
                                            <Button Content="Vừa, giữ tỉ lệ" Click="MaximumRatio_Click" />
                                        </UniformGrid>

                                        <TextBlock Text="Thứ tự lớp" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                                        <UniformGrid Columns="2">
                                            <Button Content="Lên trên cùng" Margin="0,0,4,4" Click="Front_Click" />
                                            <Button Content="Lên một lớp" Margin="0,0,0,4" Click="Forward_Click" />
                                            <Button Content="Xuống dưới cùng" Margin="0,0,4,0" Click="Back_Click" />
                                            <Button Content="Xuống một lớp" Click="Backward_Click" />
                                        </UniformGrid>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Style="{StaticResource PropTab}" Header="Khác">
                                <StackPanel Margin="6,10,16,12">
                                    <StackPanel Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}">
                                        <CheckBox Content="Khoá vị trí (không kéo / đổi cỡ bằng chuột)" IsChecked="{Binding Selected.Locked}" />
                                        <CheckBox Content="In đối tượng này" IsChecked="{Binding Selected.Printable}"
                                                  ToolTip="Bỏ tích: chỉ hiện khi thiết kế (ghi chú, khung căn chỉnh…), không in ra" />
                                    </StackPanel>
                                    <TextBlock Text="Nhóm" Style="{StaticResource Caption}" Margin="0,16,0,4" />
                                    <UniformGrid Columns="2">
                                        <Button Content="Nhóm (Ctrl+G)" Margin="0,0,4,0" Click="Group_Click" />
                                        <Button Content="Bỏ nhóm" Click="Ungroup_Click" />
                                    </UniformGrid>
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="Các đối tượng đã nhóm được chọn và di chuyển cùng nhau." />
                                    <TextBlock Text="Sao chép" Style="{StaticResource Caption}" Margin="0,16,0,4" />
                                    <UniformGrid Columns="3">
                                        <Button Content="Cắt" Margin="0,0,4,0" Click="Cut_Click" />
                                        <Button Content="Chép" Margin="0,0,4,0" Click="Copy_Click" />
                                        <Button Content="Dán" Click="Paste_Click" />
                                    </UniformGrid>
                                </StackPanel>
                            </TabItem>
                        </TabControl>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                    Visibility="{Binding NoSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Chưa chọn đối tượng" FontSize="16" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" />
                            <TextBlock Text="Thêm chữ, mã vạch, ảnh và hơn thế" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,24,0,0" MaxWidth="230">
                                Kéo khung trên vùng trống hoặc Ctrl + bấm để chọn nhiều đối tượng.<LineBreak /><LineBreak />
                                In hàng loạt: bấm “Dữ liệu”, rồi kéo tiêu đề cột thả vào chữ / mã vạch.<LineBreak />
                                Kéo thả file .lbx / .tnl / .xlsx vào cửa sổ để mở.
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>        </Grid>
    </DockPanel>
</Window>
